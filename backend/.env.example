# Copy to backend/.env.  scripts/setup.ps1 does this and generates the two secrets for you.
# The app refuses to start without SECRET_KEY and EMBEDDING_ENCRYPTION_KEY (>= 32 chars each).
# NEVER commit the real .env.

ENVIRONMENT=development            # development | production | test
LOG_LEVEL=INFO

# --- secrets (generate: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=
# Encrypts stored face templates. If you lose or change it, existing enrolments become unreadable.
EMBEDDING_ENCRYPTION_KEY=

# --- database (SQLite by default; PostgreSQL example below) ---
# DATABASE_URL=sqlite:///C:/path/to/attendance.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/attendance

# --- auth / web ---
ACCESS_TOKEN_MINUTES=480
COOKIE_SECURE=false                # set true behind HTTPS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=60
MIN_PASSWORD_LENGTH=10

# --- face model ---
MODEL_NAME=buffalo_l
DETECTION_SIZE=640                 # smaller (e.g. 320) is faster, finds fewer small faces
ONNX_PROVIDERS=CPUExecutionProvider   # GPU: CUDAExecutionProvider,CPUExecutionProvider (needs onnxruntime-gpu)
LOAD_MODEL_ON_STARTUP=true

# --- recognition defaults (editable later in Settings; these only seed the database) ---
DEFAULT_RECOGNITION_THRESHOLD=0.45
DEFAULT_RECOGNITION_MARGIN=0.04
DEFAULT_TIMEZONE=Asia/Kolkata
MIN_ENROLL_IMAGES=3
MAX_ENROLL_IMAGES=12
MAX_UPLOAD_BYTES=5242880
MAX_FRAME_BYTES=2097152
